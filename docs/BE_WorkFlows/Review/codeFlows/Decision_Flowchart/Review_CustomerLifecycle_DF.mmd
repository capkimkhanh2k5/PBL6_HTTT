flowchart TD
    Start(["Khách hàng gửi đánh giá dịch vụ<br/><code>POST /api/reviews</code>"]) --> CheckAuth{"Khách hàng đã đăng nhập<br/>và sở hữu đơn hàng?"}
    CheckAuth -- "Không hợp lệ" --> Err403["Trả về <b>HTTP 403 Forbidden</b>"]
    CheckAuth -- "Hợp lệ" --> CheckSubOrder{"Trạng thái SubOrder<br/>có là <code>COMPLETED</code>?"}

    CheckSubOrder -- "Chưa hoàn thành" --> Err400Status["Trả về <b>HTTP 400 Bad Request</b><br/><code>INVALID_SUB_ORDER_STATE</code>"]
    CheckSubOrder -- "Đã hoàn thành" --> CheckWindow{"Thời gian gửi đánh giá<br/>trong vòng 7 ngày sau ca tour?"}

    CheckWindow -- "Quá hạn 7 ngày" --> Err400Window["Trả về <b>HTTP 400 Bad Request</b><br/><code>REVIEW_PERIOD_EXPIRED</code>"]
    CheckWindow -- "Trong hạn" --> CheckDuplicate{"Đơn hàng này đã được<br/>đánh giá trước đó chưa?"}

    CheckDuplicate -- "Đã có đánh giá" --> Err409Dup["Trả về <b>HTTP 409 Conflict</b><br/><code>DUPLICATE_REVIEW</code>"]
    CheckDuplicate -- "Chưa có" --> SaveReview["<b>Lưu đánh giá mới:</b><br/>- Số sao (1-5), nhận xét, hình ảnh<br/>- Gán <code>isFlagged = false</code>, <code>isVisible = true</code><br/>- Kích hoạt sự kiện tính lại Rating điểm trung bình"]

    SaveReview --> Success201(["Trả về <b>HTTP 201 Created</b><br/><code>ReviewResponse</code>"])

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,Success201 startEnd;
    class CheckAuth,CheckSubOrder,CheckWindow,CheckDuplicate decision;
    class SaveReview action;
    class Err403,Err400Status,Err400Window,Err409Dup error;
