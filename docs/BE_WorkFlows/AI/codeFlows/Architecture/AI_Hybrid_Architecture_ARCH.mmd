    %% ==========================================
    %% 6. DANASEA AI HYBRID ARCHITECTURE (COMPREHENSIVE)
    %% Groq Cloud LLM + Quyet Small + Core Backend + Postgres V21-V25 + Redis
    %% ==========================================

    subgraph ClientLayer["🖥️ TẦNG GIAO DIỆN (CLIENT APPS)"]
        WebClient["🌐 Web App (React / Vite)"]
        MobileClient["📱 Mobile App (Flutter)"]
    end

    subgraph SecurityGateway["🛡️ BẢO MẬT & ĐIỀU PHỐI (GATEWAY & SECURITY)"]
        SecurityContext["Spring Security Context<br/>(JWT Auth & User Ownership)"]
        LocaleFilter["LocaleContextFilter<br/>(Accept-Language: VI / EN)"]
        BudgetFilter["AiExecutionBudgetFilter<br/>(X-Execution-Budget-Ms, 8s Deadline,<br/>Max 8 Concurrent AI Requests/JVM)"]
        RateLimiter["RedisRateLimiter<br/>(Token Bucket + TrustTier)"]
    end

    subgraph ControllerLayer["🎮 TẦNG BỘ ĐIỀU KHIỂN (API CONTROLLERS)"]
        AssistantCtrl["AssistantController<br/>/api/assistant/**"]
        CustomerAiCtrl["CustomerAiController<br/>/api/ai/** (Search, Nearby, Compare, Weather)"]
        ItineraryCtrl["ItineraryLifecycleController<br/>/api/ai/itineraries/** (Preview, Save, Proposals)"]
        PrefCtrl["CustomerPreferenceController<br/>/api/ai/preferences & feedback"]
        SupportWorkflowCtrl["CustomerSupportWorkflowController<br/>/api/ai/support/requests/**"]
        AssessmentCtrl["AiAssessmentController<br/>/api/ai/content-assessments & categories"]
        AdminAiCtrl["AdminAiController<br/>/api/admin/ai/** (Risk Cases & Assessments)"]
        ManualSupportCtrl["ManualSupportController<br/>/api/admin/support/requests/**"]
    end

    subgraph CoreApplicationLayer["⚙️ TẦNG NGHIỆP VỤ LÕI (APPLICATION USE CASES)"]
        ChatUC["ChatUseCase<br/>(Hội thoại đa lượt)"]
        IdemService["ChatIdempotencyService<br/>(Chống submit trùng)"]
        ArtifactMapper["AssistantArtifactMapper<br/>(Typed UI Cards)"]
        DiscoveryUC["DiscoverServicesUseCase<br/>(Search, Recommend, Nearby)"]
        ItineraryUC["PlanItineraryUseCase<br/>(Preview, Save, Accept, Replan)"]
        ComparisonUC["CompareServicesUseCase<br/>(So sánh 2-4 dịch vụ)"]
        ReviewUC["ReviewSummaryUseCase<br/>(Tóm tắt đánh giá thực tế)"]
        WeatherUC["WeatherAwareUseCase<br/>(Đánh giá an toàn thời tiết)"]
        SupportUC["CustomerSupportUseCase<br/>(Tra cứu đơn & Preview hủy)"]
        SupportRequestUC["CustomerSupportRequestUseCase<br/>(Hàng đợi đổi lịch & hỗ trợ)"]
        PrefUC["CustomerPreferenceUseCase<br/>(Sở thích & Phản hồi gợi ý)"]
        AssessTextUC["AssessTextUseCase<br/>(Regex + Text Moderation)"]
        RiskUC["AnalyzeTransactionRiskUseCase<br/>(Quy tắc Velocity 3/5/3)"]
        ConfirmBookingUC["ConfirmBookingUseCase<br/>(Re-validation, Hold & Bù trừ)"]
    end

    subgraph BackgroundJobsLayer["⏰ TẦNG TÁC VỤ NỀN (BACKGROUND JOBS)"]
        MonitoringJob["ItinerarySourceMonitoringJob<br/>(Quét thay đổi ca & cảnh báo thời tiết mỗi 60s<br/>-> Tự động sinh Re-plan Proposal & In-app Alert)"]
    end

    subgraph ToolRegistryLayer["🧰 BỘ CÔNG CỤ TRỢ LÝ (AI TOOL REGISTRY - 15 TOOLS)"]
        LegacyTools["6 Công cụ cơ bản<br/>search_services, get_service_detail,<br/>get_policy, get_weather_forecast,<br/>get_safety_alert, request_booking_confirmation"]
        CustomerTools["9 Công cụ mở rộng (CustomerFeatureTool)<br/>ai_smart_search, ai_recommend_services,<br/>ai_nearby_services, ai_compare_services,<br/>ai_plan_itinerary, ai_replan_itinerary,<br/>ai_review_summary, ai_weather_slot,<br/>ai_customer_support"]
    end

    subgraph AiInferenceLayer["🧠 TẦNG TRÍ TUỆ NHÂN TẠO LAI (HYBRID AI ENGINE)"]
        subgraph GroqCloud["☁️ GROQ CLOUD LLM (Online)"]
            GroqClient["GroqLlmClient<br/>(Llama 3.3 / Llama 3.1)"]
            GroqRotator["GroqKeyRotator<br/>(5 API Keys: ACTIVE / COOLDOWN / DISABLED)"]
            GroqModeration["GroqModerationClient<br/>(Prompt Guard - Max 1800 ký tự)"]
            GroqHighlight["GroqReviewHighlightAdapter<br/>(Trích xuất ID review có nguồn thật)"]
        end

        subgraph QuyetLocal["⚡ QUYET SMALL INFERENCE WORKER (Offline / Local CPU)"]
            QuyetClient["QuyetDecisionAdapter<br/>(REST Client /decide)"]
            QuyetTasks["Fast Decision Tasks:<br/>• INTENT (Phân loại ý định tìm kiếm)<br/>• RELEVANCE (Chấm điểm gợi ý top 5)<br/>• SERVICE_CATEGORY (Phân loại dịch vụ)<br/>• MODERATION (Spam, Abuse, Ext. Payment)<br/>• RISK (Tín hiệu rủi ro giao dịch)<br/>• REVIEW (Tách khía cạnh & cảm xúc)"]
        end
    end

    subgraph StorageLayer["💾 TẦNG LƯU TRỮ & HẠ TẦNG DỮ LIỆU"]
        subgraph PostgreSQL["🐘 POSTGRESQL DATABASE (FLYWAY MIGRATIONS V21 - V25)"]
            DB_Core["Dữ Liệu Vận Hành:<br/>• services, options, slots (Catalog)<br/>• orders, refunds, reviews (Kinh doanh)"]
            DB_V21["Flyway V21:<br/>• ai_itineraries (@Version, JSON)<br/>• ai_assessment_cases (Evidence)"]
            DB_V22["Flyway V22:<br/>• ai_chat_requests (Idempotency)<br/>• ai_conversations, ai_messages"]
            DB_V23["Flyway V23 (Lifecycle):<br/>• ai_itinerary_proposals (Diff)<br/>• ai_itinerary_previews (15m)<br/>• ai_itinerary_revisions (History)<br/>• ai_itinerary_items"]
            DB_V24["Flyway V24 (Customer Preferences & Support):<br/>• ai_customer_preferences (Consent)<br/>• ai_recommendations & feedbacks<br/>• ai_customer_support_requests"]
            DB_V25["Flyway V25:<br/>• ai_confirmation_outcomes (Durable)"]
        end

        subgraph RedisCache["⚡ REDIS IN-MEMORY"]
            Redis_Rate["Token Bucket Quota"]
            Redis_Cards["Draft Confirmation Cards (15p)"]
            Redis_Locks["Distributed Locks (Lua Script 30s)"]
            Redis_Keys["Groq Key Pool (5 Keys)"]
            Redis_Idem["Idempotency Claim Locks"]
        end
    end

    %% Flows & Interactions
    WebClient --> SecurityGateway
    MobileClient --> SecurityGateway
    SecurityGateway --> ControllerLayer

    AssistantCtrl --> IdemService
    AssistantCtrl --> ChatUC
    AssistantCtrl --> ConfirmBookingUC
    CustomerAiCtrl --> DiscoveryUC
    CustomerAiCtrl --> ComparisonUC
    CustomerAiCtrl --> ReviewUC
    CustomerAiCtrl --> WeatherUC
    CustomerAiCtrl --> SupportUC
    ItineraryCtrl --> ItineraryUC
    PrefCtrl --> PrefUC
    SupportWorkflowCtrl --> SupportRequestUC
    AssessmentCtrl --> AssessTextUC
    AdminAiCtrl --> RiskUC
    ManualSupportCtrl --> SupportRequestUC

    ChatUC --> GroqModeration
    ChatUC --> GroqClient
    ChatUC --> ToolRegistryLayer
    ChatUC --> ArtifactMapper
    GroqClient --> GroqRotator

    ToolRegistryLayer --> CoreApplicationLayer
    DiscoveryUC --> QuyetClient
    AssessTextUC --> QuyetClient
    RiskUC --> QuyetClient
    ReviewUC --> QuyetClient
    ReviewUC --> GroqHighlight

    MonitoringJob --> ItineraryUC
    MonitoringJob --> PostgreSQL

    CoreApplicationLayer --> PostgreSQL
    CoreApplicationLayer --> RedisCache
    ConfirmBookingUC --> DB_V25
    ConfirmBookingUC --> Redis_Cards
    ConfirmBookingUC --> Redis_Locks
    ItineraryUC --> DB_V21
    ItineraryUC --> DB_V23
    PrefUC --> DB_V24
    SupportRequestUC --> DB_V24
    IdemService --> DB_V22
    IdemService --> Redis_Idem

