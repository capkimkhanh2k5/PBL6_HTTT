flowchart TD
    Start(["Khách hàng yêu cầu sinh mã QR Check-in<br/><code>GET /api/sub-orders/{id}/checkin-token</code>"]) --> CheckAuth{"Khách hàng sở hữu SubOrder?"}
    CheckAuth -- "Không phải chủ đơn" --> Err403["Trả về <b>HTTP 403 Forbidden</b>"]
    CheckAuth -- "Hợp lệ" --> CheckPaid{"SubOrder có trạng thái <code>CONFIRMED</code><br/>và MasterOrder đã thanh toán <code>PAID</code>?"}

    CheckPaid -- "Chưa thanh toán / Đã hủy" --> Err400State["Trả về <b>HTTP 400 Bad Request</b><br/><code>ORDER_NOT_PAID_OR_CANCELLED</code>"]
    CheckPaid -- "Hợp lệ" --> CheckAlreadyIn{"Đã check-in trước đó chưa?<br/>(<code>checkedInAt != null</code>)?"}

    CheckAlreadyIn -- "Đã check-in rồi" --> Err400Checked["Trả về <b>HTTP 400 Bad Request</b><br/><code>ALREADY_CHECKED_IN</code>"]
    CheckAlreadyIn -- "Chưa check-in" --> GenToken["<b>Sinh Check-in Token bảo mật:</b><br/>- Ký HMAC-SHA256 với Secret định danh<br/>- Thời hạn hiệu lực gắn theo ca tour<br/>- Mã hóa payload thành chuỗi QR Base64"]

    GenToken --> Success200(["Trả về <b>HTTP 200 OK</b><br/><code>CheckinTokenResponse</code><br/>(Render QR Code trên ứng dụng)"])

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,Success200 startEnd;
    class CheckAuth,CheckPaid,CheckAlreadyIn decision;
    class GenToken action;
    class Err403,Err400State,Err400Checked error;
