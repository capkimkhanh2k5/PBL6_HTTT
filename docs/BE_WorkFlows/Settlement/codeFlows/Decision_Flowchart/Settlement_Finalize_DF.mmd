flowchart TD
    Start(["Admin chốt sổ & giải ngân kỳ đối soát<br/><code>POST /api/admin/settlements/{id}/finalize</code>"]) --> CheckAdmin{"Quyền <code>ROLE_ADMIN</code>?"}
    CheckAdmin -- "Không phải Admin" --> Err403["Trả về <b>HTTP 403 Forbidden</b>"]
    CheckAdmin -- "Hợp lệ" --> LockPeriod["Khóa bi quan kỳ đối soát<br/><code>findByIdForUpdate(id)</code>"]

    LockPeriod --> CheckStatus{"Trạng thái kỳ đối soát<br/>có là <code>PENDING_VENDOR_REVIEW</code> hoặc <code>ACCEPTED</code>?"}
    CheckStatus -- "Đang tranh chấp / Đã thanh toán" --> Err409["Trả về <b>HTTP 409 Conflict</b><br/><code>SETTLEMENT_ALREADY_FINALIZED</code>"]
    CheckStatus -- "Hợp lệ" --> VerifyBank["Kiểm tra thông tin tài khoản ngân hàng của Vendor"]

    VerifyBank --> HasBank{"Tài khoản ngân hàng hợp lệ?"}
    HasBank -- "Thiếu thông tin nhận tiền" --> Err400Bank["Trả về <b>HTTP 400 Bad Request</b><br/><code>VENDOR_BANK_INFO_MISSING</code>"]
    HasBank -- "Hợp lệ" --> ProcessPayout["<b>Thực hiện giải ngân đối soát:</b><br/>- Ghi nhận mã giao dịch chuyển khoản<br/>- Cập nhật status = <code>COMPLETED</code><br/>- Đánh dấu các SubOrders = <code>SETTLED</code><br/>- Ghi nhận Audit Log tài chính"]

    ProcessPayout --> NotifyVendor["Gửi thông báo & Email biên nhận quyết toán đến Vendor"]
    NotifyVendor --> Success200(["Trả về <b>HTTP 200 OK</b><br/><code>SettlementSummaryResponse</code>"])

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,Success200 startEnd;
    class CheckAdmin,CheckStatus,HasBank decision;
    class LockPeriod,VerifyBank,ProcessPayout,NotifyVendor action;
    class Err403,Err409,Err400Bank error;
