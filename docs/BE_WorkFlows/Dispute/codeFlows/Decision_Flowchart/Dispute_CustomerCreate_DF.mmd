flowchart TD
    Start(["Khách hàng gửi yêu cầu khiếu nại<br/><code>POST /api/disputes</code>"]) --> CheckAuth{"Khách hàng đã đăng nhập<br/>và sở hữu đơn hàng?"}
    CheckAuth -- "Không hợp lệ" --> Err403["Trả về <b>HTTP 403 Forbidden</b><br/><code>ACCESS_DENIED</code>"]
    CheckAuth -- "Hợp lệ" --> CheckStatus{"Trạng thái SubOrder<br/>có phải là <code>COMPLETED</code>?"}

    CheckStatus -- "Chưa hoàn thành" --> Err400Status["Trả về <b>HTTP 400 Bad Request</b><br/><code>SUB_ORDER_NOT_COMPLETED</code>"]
    CheckStatus -- "Đã hoàn thành" --> CheckWindow{"Thời gian khiếu nại<br/>trong vòng 3 ngày sau ca tour?"}

    CheckWindow -- "Quá hạn" --> Err400Window["Trả về <b>HTTP 400 Bad Request</b><br/><code>DISPUTE_WINDOW_EXPIRED</code>"]
    CheckWindow -- "Trong hạn" --> CheckExisting{"Đã có khiếu nại đang xử lý<br/>cho đơn hàng này chưa?"}

    CheckExisting -- "Đã tồn tại" --> Err409Exist["Trả về <b>HTTP 409 Conflict</b><br/><code>DISPUTE_ALREADY_EXISTS</code>"]
    CheckExisting -- "Chưa có" --> CreateDispute["<b>Tạo bản ghi Dispute mới:</b><br/>- Status = <code>OPEN</code><br/>- Lưu bằng chứng hình ảnh & lý do<br/>- Gửi thông báo đến Admin & Vendor"]

    CreateDispute --> Success201(["Trả về <b>HTTP 201 Created</b><br/><code>DisputeResponse</code>"])

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,Success201 startEnd;
    class CheckAuth,CheckStatus,CheckWindow,CheckExisting decision;
    class CreateDispute action;
    class Err403,Err400Status,Err400Window,Err409Exist error;
