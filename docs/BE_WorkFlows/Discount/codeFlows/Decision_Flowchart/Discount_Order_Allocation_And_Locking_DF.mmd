flowchart TD
    Start(["Khởi tạo Order kèm mã giảm giá<br/><code>CreateOrderUseCase</code>"]) --> CheckCode{"Có cung cấp discountCode?"}
    CheckCode -- "Không có" --> NormalOrder["Tạo đơn không áp dụng mã giảm"]
    CheckCode -- "Có mã" --> FindCode["Tìm DiscountCode trong DB & Cache"]

    FindCode --> ValidateCode{"Mã có hiệu lực, còn lượt dùng<br/>và đạt giá trị đơn tối thiểu?"}
    ValidateCode -- "Không hợp lệ" --> Err400Code["Trả về <b>HTTP 400 Bad Request</b><br/><code>INVALID_DISCOUNT_CODE</code>"]
    ValidateCode -- "Hợp lệ" --> CalcAlloc["<b>Discount Allocation Engine:</b><br/>- Tính số tiền giảm theo tỷ lệ % hoặc số tiền cố định<br/>- Phân bổ giảm giá giữa Platform & Vendor<br/>- Đảm bảo số tiền thanh toán cuối cùng > 0"]

    CalcAlloc --> CreateRedemption["Tạo bản ghi <code>DiscountRedemption</code><br/>trạng thái <code>RESERVED</code> (Khóa lượt dùng)"]
    CreateRedemption --> Success(["Gắn giảm giá vào Order và tiếp tục"])

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,NormalOrder,Success startEnd;
    class CheckCode,ValidateCode decision;
    class FindCode,CalcAlloc,CreateRedemption action;
    class Err400Code error;
