flowchart TD
    Start(["Khách hàng gửi yêu cầu hủy vé<br/><code>POST /api/sub-orders/{id}/cancel</code>"]) --> CheckOwner{"Khách hàng sở hữu đơn hàng?"}
    CheckOwner -- "Không hợp lệ" --> Err403["Trả về <b>HTTP 403 Forbidden</b>"]
    CheckOwner -- "Hợp lệ" --> CheckState{"Trạng thái SubOrder <code>CONFIRMED</code><br/>và chưa check-in?"}

    CheckState -- "Đã check-in / Sai trạng thái" --> Err400["Trả về <b>HTTP 400 Bad Request</b>"]
    CheckState -- "Hợp lệ" --> CheckReason{"Lý do hủy là do Thời tiết xấu<br/>(<code>WEATHER_HAZARD</code>)?"}

    CheckReason -- "Hủy do thời tiết" --> FullRefundWeather["<b>Hoàn tiền 100% không mất phí:</b><br/>Tạo bản ghi Refund với <code>refundPercentage = 100%</code>"]
    CheckReason -- "Khách tự hủy cá nhân" --> CheckHours{"Thời gian từ hiện tại<br/>đến giờ khởi hành tour?"}

    CheckHours -- ">= 48 giờ" --> Refund100["Hoàn tiền 100% giá trị vé"]
    CheckHours -- "Từ 24 đến 48 giờ" --> Refund50["Hoàn tiền 50% giá trị vé (phí hủy 50%)"]
    CheckHours -- "< 24 giờ" --> Refund0["Hoàn tiền 0% (Không được hoàn lại tiền)"]

    FullRefundWeather --> ProcessRefund["<b>Giải phóng chỗ:</b> Hoàn trả Capacity vào Slot<br/>Chuyển SubOrder status sang <code>CANCELLED</code>"]
    Refund100 --> ProcessRefund
    Refund50 --> ProcessRefund
    Refund0 --> ProcessRefund

    ProcessRefund --> Success200(["Trả về <b>HTTP 200 OK</b><br/><code>CancellationResponse</code>"])

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,Success200 startEnd;
    class CheckOwner,CheckState,CheckReason,CheckHours decision;
    class FullRefundWeather,Refund100,Refund50,Refund0,ProcessRefund action;
    class Err403,Err400 error;
