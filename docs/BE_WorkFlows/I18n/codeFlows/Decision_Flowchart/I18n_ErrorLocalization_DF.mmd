flowchart TD
    Start(["Exception phát sinh trong quá trình xử lý"]) --> CheckType{"Loại Exception?"}

    CheckType -- "LocalizedException" --> DirectKey["Lấy trực tiếp <code>errorCode</code><br/>và arguments từ Exception"]
    CheckType -- "Domain Exception cụ thể" --> MapCode["Map tên Exception sang Error Code<br/>(ví dụ: <code>OrderNotFoundException</code> -> <code>ORDER_NOT_FOUND</code>)"]
    CheckType -- "Validation Exception" --> ExtractField["Trích xuất lỗi từ Bean Validation<br/>(ví dụ: <code>{validation.reason_is_required}</code>)"]
    CheckType -- "Khác / Bất thường" --> DefaultError["Gán mã lỗi <code>INTERNAL_ERROR</code>"]

    DirectKey --> LookupBundle
    MapCode --> LookupBundle
    ExtractField --> LookupBundle
    DefaultError --> LookupBundle["<b>LocalizedMessageService tra cứu Resource Bundle:</b><br/>1. Tìm trong bundle tương ứng (<code>common</code>, <code>validation</code>...) theo Locale<br/>2. Nếu thiếu bản dịch requested -> fallback sang tiếng Việt <code>_vi</code><br/>3. Format tham số động vào message (nếu có)"]

    LookupBundle --> BuildResponse["Đóng gói <code>ErrorResponse</code> chuẩn JSON:<br/>- <code>code</code>: Error code chuẩn<br/>- <code>message</code>: Thông điệp đã bản địa hóa"]
    BuildResponse --> End(["Trả về Client với HTTP Status tương ứng"])

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;

    class Start,End startEnd;
    class CheckType decision;
    class DirectKey,MapCode,ExtractField,DefaultError,LookupBundle,BuildResponse action;
