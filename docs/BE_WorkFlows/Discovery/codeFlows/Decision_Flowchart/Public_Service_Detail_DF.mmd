flowchart TD
    Start(["Khách hàng xem chi tiết dịch vụ<br/><code>GET /api/public/services/{id}</code>"]) --> FindService["Tra cứu Service trong DB"]

    FindService --> CheckStatus{"Trạng thái Service<br/>có là <code>PUBLISHED</code>?"}
    CheckStatus -- "Nháp / Đóng" --> Err404["Trả về <b>HTTP 404 Not Found</b><br/><code>SERVICE_NOT_FOUND</code>"]
    CheckStatus -- "PUBLISHED" --> LoadSlots["Nạp danh sách ca mở bán (Slots OPEN)<br/>tính toán số chỗ khả dụng khả thi"]

    LoadSlots --> CheckWaiver{"Dịch vụ có yêu cầu<br/>cam kết an toàn (<code>waiverRequired</code>)?"}
    CheckWaiver -- "Có bắt buộc" --> AttachWaiver["Đính kèm phiên bản <code>waiverVersion</code><br/>và nội dung cam kết theo ngôn ngữ yêu cầu (hoặc fallback)"]
    CheckWaiver -- "Không bắt buộc" --> PlainDetail["Gán <code>waiverRequired = false</code>"]

    AttachWaiver --> Success200(["Trả về <b>HTTP 200 OK</b><br/><code>ServiceDetailResponse</code>"])
    PlainDetail --> Success200

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,Success200 startEnd;
    class CheckStatus,CheckWaiver decision;
    class FindService,LoadSlots,AttachWaiver,PlainDetail action;
    class Err404 error;
