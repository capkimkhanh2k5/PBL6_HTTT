flowchart TD
    %% ==========================================
    %% DECISION FLOWCHART: AUTH OTP VERIFICATION & BRUTE-FORCE DEFENSE
    %% DANASEA Marine Tourism Platform
    %% ==========================================

    Start(["Khách hàng gửi yêu cầu đặt lại mật khẩu<br/><code>POST /api/auth/reset-password</code><br/>Body: <code>{email, otp, newPassword}</code>"]) --> RateLimit{"Kiểm tra Rate Limit IP<br/>(Bucket4j / Redis)<br/>Tối đa 5 requests/phút?"}

    RateLimit -- "Vượt ngưỡng" --> Err429["Trả về <b>HTTP 429 Too Many Requests</b><br/>Kèm header <code>Retry-After</code>"]
    RateLimit -- "Hợp lệ" --> LockUser["Khóa bi quan người dùng:<br/><code>SELECT * FROM users WHERE email = ? FOR UPDATE</code>"]

    LockUser --> CheckUser{"User tồn tại & không bị khóa?"}
    CheckUser -- "Không tồn tại / Bị khóa" --> ErrUser["Ném <code>OtpInvalidException</code> (HTTP 400 - AUTH_007)<br/><i>(Anti-Enumeration: Giấu trạng thái tài khoản)</i>"]

    CheckUser -- "Tài khoản hợp lệ" --> FindOTP{"Tìm mã OTP hợp lệ trong DB<br/><code>used = false && expiresAt > now()</code>?"}
    FindOTP -- "Không tìm thấy / Đã hết hạn" --> ErrExpired["Ném <code>OtpExpiredException</code> (HTTP 400 - AUTH_007)<br/>Mã OTP không hợp lệ hoặc đã hết hạn"]

    FindOTP -- "Tìm thấy OTP" --> CheckLimit{"Số lần thử sai trước đó<br/><code>failedAttempts >= 5</code>?"}
    CheckLimit -- "Đã thử sai >= 5 lần" --> LockOldToken["Đánh dấu hủy token: <code>used = true</code><br/>Ném <code>OtpMaxAttemptsExceededException</code> (HTTP 400 - AUTH_008)"]

    CheckLimit -- "Chưa quá 5 lần (< 5)" --> VerifyHash{"Đối chiếu băm SHA-256:<br/><code>sha256(rawOtp) == token.tokenHash</code>?"}

    %% NHÁNH SAI OTP
    VerifyHash -- "SAI MÃ OTP" --> IncFail["Tăng bộ đếm thử sai:<br/><code>failedAttempts = min(5, failedAttempts + 1)</code><br/><b>Commit độc lập (noRollbackFor)</b>"]
    IncFail --> CheckMax{"Số lần sai mới >= 5?"}
    CheckMax -- "Đạt mốc 5" --> LockNow["Khóa token vĩnh viễn: <code>used = true</code><br/>Ném <code>OtpMaxAttemptsExceededException</code> (HTTP 400 - AUTH_008)"]
    CheckMax -- "Dưới 5" --> ErrInvalid["Ném <code>OtpInvalidException</code> (HTTP 400 - AUTH_007)<br/>(Commit số lần sai vào DB)"]

    %% NHÁNH ĐÚNG OTP
    VerifyHash -- "ĐÚNG MÃ OTP" --> SuccessOTP(["<b>Xác thực OTP thành công!</b><br/>Chuyển sang luồng cập nhật mật khẩu & thu hồi phiên"])

    %% Style classes
    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,SuccessOTP startEnd;
    class RateLimit,CheckUser,FindOTP,CheckLimit,VerifyHash,CheckMax decision;
    class LockUser,IncFail action;
    class Err429,ErrUser,ErrExpired,LockOldToken,LockNow,ErrInvalid error;
