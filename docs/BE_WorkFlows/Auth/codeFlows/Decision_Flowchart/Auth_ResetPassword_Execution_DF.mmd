flowchart TD
    %% ==========================================
    %% DECISION FLOWCHART: AUTH PASSWORD RESET EXECUTION & SESSION REVOCATION
    %% DANASEA Marine Tourism Platform
    %% ==========================================

    Start(["Mã OTP đã được xác thực thành công<br/>Bắt đầu cập nhật mật khẩu mới"]) --> HashPassword["Băm mật khẩu mới bằng <b>BCrypt</b><br/><code>password = PasswordHasher.hash(newPassword)</code>"]

    HashPassword --> RevokeSessions["<b>Thu hồi toàn diện phiên đăng nhập cũ:</b><br/>1. Tăng phiên bản: <code>sessionVersion = sessionVersion + 1</code><br/>   <i>(Vô hiệu hóa ngay lập tức mọi JWT Access Token đang lưu hành)</i><br/>2. Đánh dấu token: <code>used = true, usedAt = now()</code><br/>3. Thu hồi toàn bộ Refresh Token trong Redis: <code>revoked_at = now()</code>"]

    RevokeSessions --> SaveUser["Lưu trạng thái User mới vào PostgreSQL<br/><code>userRepo.save(user)</code>"]

    SaveUser --> WriteAudit["Ghi nhận <b>Audit Log an ninh</b><br/><code>action: PASSWORD_RESET</code>"]

    WriteAudit --> CheckAudit{"Ghi Audit Log thành công?"}
    CheckAudit -- "Lỗi kết nối Audit DB" --> Rollback["<b>Rollback toàn bộ giao dịch!</b><br/>Bảo lưu mật khẩu cũ để đảm bảo an ninh"]
    CheckAudit -- "Thành công" --> Success200(["Trả về <b>HTTP 200 OK</b><br/><i>'Đặt lại mật khẩu thành công. Vui lòng đăng nhập lại.'</i>"])

    %% Style classes
    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;

    class Start,Success200 startEnd;
    class CheckAudit decision;
    class HashPassword,RevokeSessions,SaveUser,WriteAudit action;
    class Rollback error;
