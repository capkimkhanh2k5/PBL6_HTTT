flowchart LR
    %% ==========================================
    %% DECISION FLOWCHART: AUTH RESET PASSWORD & BRUTE-FORCE DEFENSE
    %% DANASEA Marine Tourism Platform (Balanced 3-Phase Layout)
    %% ==========================================

    subgraph P1 ["🛡️ PHA 1: KIỂM SOÁT & KHÓA USER"]
        direction TB
        Start(["POST /api/auth/reset-password<br/>email, otp, newPassword"]) --> RateLimit{"Rate Limit IP<br/>Bucket4j <= 5 req/m?"}
        RateLimit -- "Vượt ngưỡng" --> Err429["HTTP 429 Too Many Requests"]
        RateLimit -- "Hợp lệ" --> LockUser["Khóa bi quan User:<br/>SELECT * FROM users FOR UPDATE"]
        LockUser --> CheckUser{"User tồn tại<br/>& không bị khóa?"}
        CheckUser -- "Không / Bị khóa" --> ErrUser["HTTP 400 AUTH_007<br/>(Anti-Enumeration)"]
        CheckUser -- "Hợp lệ" --> UserOK["Chuyển sang xác thực OTP"]
    end

    subgraph P2 ["🔍 PHA 2: XÁC THỰC OTP & CHỐNG BRUTE-FORCE"]
        direction TB
        FindOTP{"Tìm OTP hợp lệ<br/>used=false & còn hạn?"} --> CheckLimit{"Số lần thử sai<br/>failedAttempts >= 5?"}
        CheckLimit -- "Đã >= 5" --> LockOld["used = true<br/>HTTP 400 AUTH_008 (Đã khóa)"]
        CheckLimit -- "< 5" --> CheckHash{"sha256(rawOtp)<br/>== tokenHash?"}
        CheckHash -- "SAI" --> IncFail["failedAttempts + 1<br/>(Commit noRollbackFor)"]
        IncFail --> CheckMax{"Đạt mốc 5 lần?"}
        CheckMax -- "Đạt 5" --> LockNow["used = true<br/>HTTP 400 AUTH_008"]
        CheckMax -- "< 5" --> ErrWrong["HTTP 400 AUTH_007 (Sai OTP)"]
        CheckHash -- "ĐÚNG" --> OTPOK["Xác thực OTP thành công"]
    end

    subgraph P3 ["🔐 PHA 3: ĐẶT MẬT KHẨU & THU HỒI PHIÊN"]
        direction TB
        HashPwd["Băm mật khẩu mới BCrypt"] --> Revoke["Thu hồi phiên toàn diện:<br/>- Tăng sessionVersion + 1<br/>- used = true, usedAt = now()<br/>- Thu hồi mọi Refresh Token"]
        Revoke --> Audit["Ghi Audit Log: PASSWORD_RESET"]
        Audit --> Success(["HTTP 200 OK<br/>Đặt lại mật khẩu thành công"])
    end

    UserOK --> FindOTP
    OTPOK --> HashPwd

    classDef startEnd fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef decision fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef action fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#15803d;
    classDef error fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#b91c1c;
    classDef phase fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px,color:#334155;

    class Start,Success startEnd;
    class RateLimit,CheckUser,FindOTP,CheckLimit,CheckHash,CheckMax decision;
    class LockUser,UserOK,OTPOK,HashPwd,Revoke,Audit action;
    class Err429,ErrUser,LockOld,IncFail,LockNow,ErrWrong error;
    class P1,P2,P3 phase;
