flowchart TD
    subgraph ClientLayer["Lớp Client / Người Dùng"]
        Admin["Quản Trị Viên (Admin Web)"]
        Vendor["Đối Tác Dịch Vụ (Vendor App/Web)"]
    end

    subgraph SecurityLayer["Lớp Bảo Mật & Xác Thực (Spring Security)"]
        JwtFilter["JwtAuthenticationFilter"]
        SecurityContext["SecurityContext (Current User ID)"]
        VendorInternal["VendorInternalApi (Phân giải Vendor ID)"]
        AdminAuth{"@PreAuthorize\nhasRole('ADMIN')"}
        VendorAuth{"@PreAuthorize\nhasRole('VENDOR')"}
    end

    subgraph PresentationLayer["Tầng Presentation (Controllers & DTOs)"]
        AdminCtrl["AdminController\n(GET /api/admin/dashboard)"]
        AdminReportCtrl["AdminReportController\n(GET /api/admin/reports/*)"]
        VendorDashCtrl["VendorDashboardController\n(GET /api/vendor/dashboard)"]
        VendorReportCtrl["VendorReportController\n(GET /api/vendor/reports/*)"]
        
        AdminDashDTO["AdminDashboardResponse\n(status: ADMIN_ACCESS_GRANTED + Real KPIs)"]
        VendorDashDTO["VendorDashboardResponse"]
        RevDTO["RevenueReportResponse"]
        BookDTO["BookingReportResponse"]
        VendorPerfDTO["VendorPerformanceResponse"]
    end

    subgraph ApplicationLayer["Tầng Application (Use Cases & Helpers)"]
        GetAdminDash["GetAdminDashboardUseCase"]
        GetVendorDash["GetVendorDashboardUseCase"]
        GetRevReport["GetRevenueReportUseCase"]
        GetBookReport["GetBookingReportUseCase"]
        GetVendorPerf["GetVendorPerformanceReportUseCase"]
        ExportCsv["ExportReportCsvUseCase"]
        
        TimeHelper["TimeSeriesPeriodHelper\n(Day/Week/Quarter/Year Grouping & Zero-Filling)"]
    end

    subgraph DomainLayer["Tầng Domain (Models, Value Objects & Ports)"]
        TimeRangeVO["TimeRange (Asia/Ho_Chi_Minh UTC+7)\n[from 00:00:00 to 23:59:59]"]
        DashMetrics["DashboardMetrics"]
        RevItem["RevenueReportItem\n(GMV, Cash, Refund, Comm, Net Payout)"]
        BookItem["BookingReportItem\n(Total, Completed, Cancelled + Reasons)"]
        VendorPerfItem["VendorPerformanceItem & Diagnostic Engine\n(HEALTHY / WARNING / CRITICAL)"]
        
        ReportPort[("ReportDataPort")]
        CsvPort[("CsvExporterPort")]
    end

    subgraph InfrastructureLayer["Tầng Infrastructure & Database"]
        JpaAdapter["JpaReportDataAdapter\n(JPQL / SQL DB-Agnostic, Parameterized)"]
        CsvExporter["Rfc4180Utf8BomCsvExporter\n(RFC 4180, 3-byte UTF-8 BOM, CRLF)"]
        
        DB[(Cơ Sở Dữ Liệu PostgreSQL / H2)]
        SubOrders[("sub_orders")]
        Payments[("payments")]
        Refunds[("refunds")]
        Slots[("service_slots")]
        Reviews[("reviews")]
        Vendors[("vendors")]
    end

    %% Luồng Admin
    Admin -->|JWT Token| JwtFilter
    JwtFilter --> AdminAuth
    AdminAuth -->|Hợp lệ| AdminCtrl
    AdminAuth -->|Hợp lệ| AdminReportCtrl

    %% Luồng Vendor & Isolation
    Vendor -->|JWT Token| JwtFilter
    JwtFilter --> VendorAuth
    VendorAuth -->|Hợp lệ| SecurityContext
    SecurityContext --> VendorInternal
    VendorInternal -->|Trích xuất vendorId an toàn| VendorDashCtrl
    VendorInternal -->|Trích xuất vendorId an toàn| VendorReportCtrl

    %% Kết nối Controller tới UseCases
    AdminCtrl --> GetAdminDash
    VendorDashCtrl --> GetVendorDash
    AdminReportCtrl --> GetRevReport
    AdminReportCtrl --> GetBookReport
    AdminReportCtrl --> GetVendorPerf
    AdminReportCtrl --> ExportCsv
    
    VendorReportCtrl --> GetRevReport
    VendorReportCtrl --> GetBookReport
    VendorReportCtrl --> ExportCsv

    %% UseCases phụ thuộc Domain & Helpers
    GetRevReport -.-> TimeHelper
    GetBookReport -.-> TimeHelper
    GetAdminDash -.-> TimeRangeVO
    GetRevReport -.-> TimeRangeVO
    GetVendorPerf -.-> VendorPerfItem

    %% Cổng Port
    GetAdminDash --> ReportPort
    GetVendorDash --> ReportPort
    GetRevReport --> ReportPort
    GetBookReport --> ReportPort
    GetVendorPerf --> ReportPort
    ExportCsv --> CsvPort
    ExportCsv --> ReportPort

    %% Triển khai Port tại Infra
    JpaAdapter -.->|Triển khai| ReportPort
    CsvExporter -.->|Triển khai| CsvPort

    %% Truy vấn Database
    JpaAdapter --> DB
    DB --- SubOrders
    DB --- Payments
    DB --- Refunds
    DB --- Slots
    DB --- Reviews
    DB --- Vendors

    %% Trả kết quả DTO
    GetAdminDash --> AdminDashDTO
    GetVendorDash --> VendorDashDTO
    GetRevReport --> RevDTO
    GetBookReport --> BookDTO
    GetVendorPerf --> VendorPerfDTO
    ExportCsv -->|Dữ liệu file CSV UTF-8 BOM| AdminReportCtrl
    ExportCsv -->|Dữ liệu file CSV UTF-8 BOM| VendorReportCtrl
